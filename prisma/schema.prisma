datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum AggregationMethod {
  BORDA
  SCHULZE
  KEMENY_YOUNG
}

enum ReasonSide {
  FOR
  AGAINST
}

enum EventActor {
  HOST
  PARTICIPANT
  SYSTEM
}

enum RoomStatus {
  DRAFT
  ROUND_OPEN
  INSUFFICIENT_VOTES
  PROCESSING
  ROUND_FEEDBACK
  CONCLUDED
  CANCELLED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique @db.VarChar(100)
  password_hash String
  name          String   @db.VarChar(50)
  created_at    DateTime @default(now())
  rooms         Room[]
}

model Room {
  id            String            @id @default(cuid())
  pin           String            @unique @db.VarChar(6) // 6 alphanumeric characters
  title         String            @db.VarChar(100)
  host_id       String
  host          User              @relation(fields: [host_id], references: [id], onDelete: Cascade)
  method        AggregationMethod @default(BORDA)
  max_members   Int               @default(40)
  tau_threshold Float             @default(0.80)
  max_rounds    Int               @default(3)
  current_round Int               @default(1)
  status        RoomStatus        @default(DRAFT)
  deadline      DateTime?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  options       Option[]
  participants  Participant[]
  reports       RoundReport[]
  voteRevisions VoteRevision[]
  events        RoomEvent[]

  @@index([status, deadline])
  @@index([host_id])
}

model Option {
  id          String   @id @default(cuid())
  room_id     String
  room        Room     @relation(fields: [room_id], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(80)
  description String   @db.VarChar(300)
  order_index Int
  votes       Vote[]

  @@unique([room_id, order_index])
}

model Participant {
  id         String   @id @default(cuid())
  room_id    String
  room       Room     @relation(fields: [room_id], references: [id], onDelete: Cascade)
  nickname   String   @db.VarChar(30)
  pin_hash   String   // bcrypt cost=10
  blind_code String   @db.VarChar(30) // e.g. "Participante 01"
  is_retired Boolean  @default(false)
  created_at DateTime @default(now())
  votes      Vote[]
  voteRevisions VoteRevision[]
  events     RoomEvent[]

  @@unique([room_id, nickname])
  @@unique([room_id, blind_code])
}

model Vote {
  id             String      @id @default(cuid())
  participant_id String
  participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  round          Int
  option_id      String
  option         Option      @relation(fields: [option_id], references: [id], onDelete: Cascade)
  position       Int         // 1..n strict ballot
  justification  String?     @db.VarChar(200) // legacy single reason; null for votes that use VoteReason
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  reasons        VoteReason[]

  @@unique([participant_id, round, option_id])
  @@unique([participant_id, round, position])
  @@index([participant_id, round])
  @@index([option_id, round])
}

model RoundReport {
  id                 String   @id @default(cuid())
  room_id            String
  room               Room     @relation(fields: [room_id], references: [id], onDelete: Cascade)
  round              Int
  effective_voters   Int
  collective_ranking Json     // Array with positions and mid-ranks
  obtained_tau       Float    // tau*
  arguments_json     Json     // Blind qualitative arguments
  created_at         DateTime @default(now())

  @@unique([room_id, round])
}

// Optional reasons for or against an option, several per side. Stored verbatim.
model VoteReason {
  id          String     @id @default(cuid())
  vote_id     String
  vote        Vote       @relation(fields: [vote_id], references: [id], onDelete: Cascade)
  side        ReasonSide
  text        String     @db.VarChar(200)
  order_index Int // 0-based order within the side
  created_at  DateTime   @default(now())

  @@unique([vote_id, side, order_index])
  @@index([vote_id])
}

// Append-only history of every distinct ballot a participant submitted in a round.
model VoteRevision {
  id             String      @id @default(cuid())
  room_id        String
  room           Room        @relation(fields: [room_id], references: [id], onDelete: Cascade)
  participant_id String
  participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  round          Int
  version        Int // 1, 2, 3... per participant and round
  snapshot       Json // positions and reasons as submitted
  created_at     DateTime    @default(now())

  @@unique([participant_id, round, version])
  @@index([room_id, round])
}

// Room activity log. Never stores ballot content.
model RoomEvent {
  id             String       @id @default(cuid())
  room_id        String
  room           Room         @relation(fields: [room_id], references: [id], onDelete: Cascade)
  round          Int?
  type           String       @db.VarChar(40)
  actor          EventActor
  participant_id String?
  participant    Participant? @relation(fields: [participant_id], references: [id], onDelete: SetNull)
  data           Json?
  created_at     DateTime     @default(now())

  @@index([room_id, created_at])
  @@index([room_id, type, round])
}
