{
  "name": "gdss-rfastcr",
  "version": "1.0.0",
  "private": true,
  "description": "r-FAST-CR monorepo: backend/ (engine, data, services, worker) and frontend/ (Next.js).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @mic/frontend",
    "build": "npm run build -w @mic/frontend",
    "start": "npm run start -w @mic/frontend",
    "lint": "npm run lint -w @mic/frontend",
    "typecheck": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "test": "npm test -w @mic/backend && npm test -w @mic/frontend",
    "worker": "npm run worker -w @mic/backend",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node backend/prisma/seed.js"
  },
  "devDependencies": {
    "playwright": "^1.48.0",
    "prisma": "^5.21.1"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  }
}
