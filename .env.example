# Database Credentials
POSTGRES_DB=gdss_db
POSTGRES_USER=gdss_user
POSTGRES_PASSWORD=change_this_password_in_production_32chars_min

# Database Connection URL
# For Docker Compose: postgresql://gdss_user:change_this_password_in_production_32chars_min@db:5432/gdss_db?schema=public
# For local host dev: postgresql://gdss_user:change_this_password_in_production_32chars_min@localhost:5432/gdss_db?schema=public
DATABASE_URL=postgresql://gdss_user:change_this_password_in_production_32chars_min@db:5432/gdss_db?schema=public

# NextAuth Configuration (generate with: openssl rand -base64 48)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_at_least_32_characters_long

# Background Worker Secret (generate with: openssl rand -base64 48)
WORKER_SECRET=generate_a_random_secret_at_least_32_characters_long
BACKGROUND_WORKER_INTERVAL_SEC=60

# Proxy Configuration (number of trusted reverse proxies between client and app)
TRUSTED_PROXY_HOPS=0

# Development seed (npm run prisma:seed). Deletes rooms, participants and votes.
# Refuses to run with NODE_ENV=production unless ALLOW_PRODUCTION_SEED=true.
SEED_HOST_EMAIL=
SEED_HOST_PASSWORD=
# Optional, default "Anfitrión de prueba"
SEED_HOST_NAME=
